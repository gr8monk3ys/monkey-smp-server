* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
package/*.txt text eol=crlf
player/*.txt text eol=crlf
# Read by Linux inside the container: LF even when checked out on Windows.
package/docker/** text eol=lf
*.png binary
# An iCalendar file must keep its CRLF line endings (RFC 5545): tools/season_ics.py writes it, byte for byte.
*.ics -text
*.zip binary
*.mrpack binary
*.jar binary
# Run by sh on Linux and macOS: always LF, whatever the checkout.
*.sh text eol=lf
*.command text eol=lf
package/monkey/pwsh.lock text eol=lf
*.class binary
# The staff page build is compared byte for byte with a fresh build (tools/staff_ui_fresh.py): LF everywhere.
deploy/staff/** text eol=lf
