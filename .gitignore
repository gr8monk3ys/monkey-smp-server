# build output
dist/
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc

# a server installed from package/ for local testing (never commit worlds, jars or secrets)
package/server/
package/java/
package/backups/
package/downloads/
package/smoke-console.log*
package/pwsh/
package/exports/
package/.realms-launch
package/loadtest/
package/scheduled-backups.log

# agent worktrees
.claude/worktrees/

# docker compose settings of a maintainer test run from package/docker (never ship them)
package/docker/.env

# store exports for tools/funnel.py hold buyers' names and emails (only the synthetic fixture is committed)
*.csv
!tests/fixtures/*.csv

# Impeccable's one-off direction roll and review screenshots (5 MB, retaken for each review)
.impeccable/questions/
.impeccable/review/

# the site's dependencies and build output (site/README.md; site/.gitignore lists them too)
site/node_modules/
site/.next/
site/out/
