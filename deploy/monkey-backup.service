# Backs up the live server folder to Cloudflare R2 (monkey-backup.sh). Started every hour by
# monkey-backup.timer; install with docs/LIVE.md, "Backups off the machine". Run one now with
# systemctl start monkey-backup.
[Unit]
Description=Monkey SMP: back up the world to R2
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# Root, because only root may read /etc/monkey-backup.env (the R2 keys and the restic password).
User=root
ExecStart=/bin/sh /srv/monkey/repo/deploy/monkey-backup.sh
# If the run was killed before it could turn saving back on, do it now. Does nothing otherwise.
ExecStopPost=-/bin/sh /srv/monkey/repo/deploy/monkey-backup.sh --save-on
# /var/cache/monkey-backup (restic's cache) and /var/lib/monkey-backup (the script's state).
CacheDirectory=monkey-backup
StateDirectory=monkey-backup
# Behind the server for CPU and disk, and restic on one thread, so the VPS's other thread stays the
# server's and the backup doesn't cost it ticks.
Environment=GOMAXPROCS=1
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# A deploy can make it wait up to 45 minutes, and the first upload sends the whole world.
TimeoutStartSec=2h
