# Places and moves the outposts (deploy/monkey-outposts.sh, tools/outposts.py). Started every hour by
# monkey-outposts.timer; install with `sudo sh /srv/monkey/repo/deploy/monkey-outposts.sh --install` (docs/LIVE.md).
[Unit]
Description=Monkey SMP: outposts
After=docker.service

[Service]
Type=oneshot
User=monkey
Group=monkey
ExecStart=/bin/sh /srv/monkey/repo/deploy/monkey-outposts.sh
