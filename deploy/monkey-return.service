# Brings eliminated players back after 24 hours (deploy/monkey-return.sh, tools/timed_return.py). Started every
# 10 minutes by monkey-return.timer; install with `sudo sh /srv/monkey/repo/deploy/monkey-return.sh --install`.
[Unit]
Description=Monkey SMP: the 24-hour return from elimination
OnFailure=monkey-alert@%n.service
After=docker.service

[Service]
Type=oneshot
User=monkey
Group=monkey
ExecStart=/bin/sh /srv/monkey/repo/deploy/monkey-return.sh
