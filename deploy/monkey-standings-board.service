# Puts this week's faction standings so far on the in-game board (monkey-standings.sh board). Started by
# monkey-standings-board.timer; install with deploy/install-standings.sh (docs/LIVE.md). Skips the hour when a
# deploy, restart or backup holds the deploy lock.
[Unit]
Description=Monkey SMP: faction standings board update
After=docker.service

[Service]
Type=oneshot
User=monkey
Group=monkey
ExecStart=/bin/sh /srv/monkey/repo/deploy/monkey-standings.sh board
TimeoutStartSec=10min
Nice=10
