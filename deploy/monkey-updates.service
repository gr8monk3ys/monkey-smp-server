# Looks for newer builds of what the live release pins (monkey-updates.sh). Started by monkey-updates.timer;
# install with docs/LIVE.md. Read-only: it changes nothing on the server.
[Unit]
Description=Monkey SMP: weekly update check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=monkey
Group=monkey
ExecStart=/bin/sh /srv/monkey/repo/deploy/monkey-updates.sh
# A minute of web requests; let the game thread go first.
Nice=10
TimeoutStartSec=30min
