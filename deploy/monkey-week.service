# Tells the server which challenge week it is and when Season I's launch weekend ends (deploy/monkey-week.sh,
# tools/challenges.py). Started every hour by monkey-week.timer; install with
# `sudo sh /srv/monkey/repo/deploy/monkey-week.sh --install` (docs/LIVE.md).
[Unit]
Description=Monkey SMP: weekly challenges and launch weekend clock
After=docker.service

[Service]
Type=oneshot
User=monkey
Group=monkey
ExecStart=/bin/sh /srv/monkey/repo/deploy/monkey-week.sh
