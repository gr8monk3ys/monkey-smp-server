# Settings for realms-backup.sh: the off-site copy of the server in a Cloudflare R2 bucket (docs/LIVE.md,
# "Backups off the machine"). As root, copy it to /etc/realms-backup.env and make it root-only:
#     install -m 600 -o root -g root realms-backup.env.example /etc/realms-backup.env
# then type the values in on the VPS (nano /etc/realms-backup.env). Never put real values in the repo.
#
# One KEY=value per line, comments on lines of their own. A value is used exactly as written ($, quotes
# and spaces are kept); put it in quotes only if it starts or ends with a space.

# The bucket as a restic repository: s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET>
# (in Cloudflare: R2 > the bucket > Settings > S3 API, with "s3:" in front).
RESTIC_REPOSITORY=

# An R2 API token with "Object Read & Write" on this bucket only: its Access Key ID and Secret Access Key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 has a single region, called auto.
AWS_DEFAULT_REGION=auto

# The restic password: it encrypts the backups, and without it nobody can read them, you included.
# Make a long random one in your password manager and keep it THERE as well as here: if this VPS dies,
# this file dies with it. The R2 keys can be made again; this password cannot.
RESTIC_PASSWORD=

# How many snapshots R2 keeps: the last 48 hours, then one a day for 14 days, one a week for 8 weeks
# and one a month for 6 months.
KEEP_HOURLY=48
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=6
