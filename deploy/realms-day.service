# Starts a new day for the wardrobe's "days played" count (deploy/realms-day.sh, tools/wardrobe.py). Started by
# realms-day.timer; install with `sudo sh /srv/realms/repo/deploy/realms-day.sh --install` (docs/LIVE.md). If the
# server is down or the command isn't accepted, it tries again every 10 minutes until it is.
[Unit]
Description=Monkey SMP: start a new wardrobe day
After=docker.service

[Service]
Type=oneshot
User=realms
Group=realms
ExecStart=/bin/sh /srv/realms/repo/deploy/realms-day.sh
Restart=on-failure
RestartSec=10min
