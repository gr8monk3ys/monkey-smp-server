# Starts a new day for the wardrobe's "days played" count (tools/wardrobe.py). Started by realms-day.timer;
# install with docs/LIVE.md. If the server is down, it retries every 10 minutes until it answers.
[Unit]
Description=Monkey SMP: start a new wardrobe day
After=docker.service

[Service]
Type=oneshot
User=realms
Group=realms
ExecStart=/usr/bin/docker compose --project-directory /srv/realms/TheRealms-Server/docker -f /srv/realms/TheRealms-Server/docker/compose.yaml exec -T realms realms rcon "function realms:wardrobe/day"
Restart=on-failure
RestartSec=10min
