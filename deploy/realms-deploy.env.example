# Settings for realms-deploy.sh. Copy to /etc/realms-deploy.env (sudo cp ... ; sudo chmod 600 ...).

# The git clone of the repo (read-only deploy key) and the live release folder the server runs from.
REPO_DIR=/srv/realms/repo
LIVE_DIR=/srv/realms/TheRealms-Server

# What goes live: "tags" = the newest vX.Y.Z release tag (recommended: a release also publishes the
# player pack that matches it). A branch name (e.g. main) deploys every push to that branch instead.
TRACK=tags

# Minutes of warning in chat when players are online.
WARN_MINUTES=5

# Seconds to wait for the server to answer after a restart before rolling back. The first start on a
# new machine downloads about 500 MB, so keep this generous.
BOOT_TIMEOUT=900

# Optional: a Discord channel webhook for "back up on vX" / "rolled back" messages.
DISCORD_WEBHOOK_URL=
