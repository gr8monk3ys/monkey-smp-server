# Settings for realms-deploy.sh. Copy to /etc/realms-deploy.env (sudo cp ...; sudo chown root:realms ...; sudo chmod 640 ...: the service runs as realms).

# The git clone of the repo (read-only deploy key) and the live release folder the server runs from.
REPO_DIR=/srv/realms/repo
LIVE_DIR=/srv/realms/TheRealms-Server

# What goes live: "tags" = the newest vX.Y.Z release tag (recommended: a release also publishes the
# player pack that matches it). A branch name (e.g. main) deploys every push to that branch instead.
TRACK=tags

# When a new release may go live, HH:MM-HH:MM in DEPLOY_TZ (it may cross midnight, e.g. 23:00-01:00).
# A release tagged outside the window waits for it; `realms-deploy.sh --now` deploys right away.
# Empty = deploy within 5 minutes of the tag, at any time. The first deploy never waits.
DEPLOY_WINDOW=04:00-05:00
DEPLOY_TZ=America/Los_Angeles

# Minutes of warning in chat when players are online.
WARN_MINUTES=5

# Seconds to wait for the server to answer after a restart before rolling back. The first start on a
# new machine downloads about 500 MB, so keep this generous.
BOOT_TIMEOUT=900

# How many world backups to keep in backups/ (each deploy takes one first). The hourly off-site
# copy (realms-backup.sh) holds the history, so a few are enough here.
KEEP_BACKUPS=3

# Optional: a Discord channel webhook for "back up on vX" / "rolled back" messages.
DISCORD_WEBHOOK_URL=

# Optional: a staff-only channel for the daily restart (with a spark health link), the weekly update check
# and load-test results. Empty = DISCORD_WEBHOOK_URL.
STAFF_WEBHOOK_URL=

# The daily restart (realms-restart.timer) skips a server that has been up for fewer hours than this
# (default 6), e.g. because a release went live in the deploy window just before it. Left unset here so
# `RESTART_MIN_UPTIME=0 sh realms-deploy.sh --restart` can force one.
#RESTART_MIN_UPTIME=6
