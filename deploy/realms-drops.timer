# Runs realms-drops.service every 10 minutes, 30 seconds past. Outside drop hours (Monday to Thursday, 6 to
# 10 PM Pacific) it sends nothing, so the server's own time zone doesn't matter. No catching up at boot: a
# missed slot is just the next one.
[Unit]
Description=Monkey SMP: weeknight supply drops, every 10 minutes

[Timer]
OnCalendar=*-*-* *:00/10:30
Persistent=false

[Install]
WantedBy=timers.target
