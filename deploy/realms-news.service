# Posts Monkey SMP news to the public Discord channel (deploy/realms-news.sh, tools/news.py). Started every 10
# minutes by realms-news.timer; install with `sudo sh /srv/realms/repo/deploy/realms-news.sh --install`
# (docs/LIVE.md). Skips the run when a deploy, restart or backup holds the deploy lock.
[Unit]
Description=Monkey SMP: news to Discord
After=docker.service

[Service]
Type=oneshot
User=realms
Group=realms
ExecStart=/bin/sh /srv/realms/repo/deploy/realms-news.sh
TimeoutStartSec=5min
Nice=10
