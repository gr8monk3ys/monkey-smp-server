# Offers the evening's omen (deploy/realms-omens.sh, tools/omens.py). Started every 10 minutes by
# realms-omens.timer; install with `sudo sh /srv/realms/repo/deploy/realms-omens.sh --install` (docs/LIVE.md).
[Unit]
Description=Monkey SMP: omens
After=docker.service

[Service]
Type=oneshot
User=realms
Group=realms
ExecStart=/bin/sh /srv/realms/repo/deploy/realms-omens.sh
