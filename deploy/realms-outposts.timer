# Runs realms-outposts.service every hour at 45 past, away from the standings board (20 past) and the drops'
# 10-minute slots. No catching up at boot: a missed hour is just the next one.
[Unit]
Description=Monkey SMP: outposts, every hour

[Timer]
OnCalendar=*-*-* *:45:00
Persistent=false

[Install]
WantedBy=timers.target
