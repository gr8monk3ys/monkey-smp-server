# Restarts the server once (realms-deploy.sh --restart). Started by realms-restart.timer; install with docs/LIVE.md.
[Unit]
Description=Monkey SMP: daily restart
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=realms
Group=realms
ExecStart=/bin/sh /srv/realms/repo/deploy/realms-deploy.sh --restart
# Up to 30 minutes waiting for a deploy or backup, the 5-minute warning, then the start.
TimeoutStartSec=60min
