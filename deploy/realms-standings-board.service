# Puts this week's faction standings so far on the in-game board (realms-standings.sh board). Started by
# realms-standings-board.timer; install with deploy/install-standings.sh (docs/LIVE.md). Skips the hour when a
# deploy, restart or backup holds the deploy lock.
[Unit]
Description=Monkey SMP: faction standings board update
After=docker.service

[Service]
Type=oneshot
User=realms
Group=realms
ExecStart=/bin/sh /srv/realms/repo/deploy/realms-standings.sh board
TimeoutStartSec=10min
Nice=10
