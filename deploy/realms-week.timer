# Runs realms-week.service every hour, 30 seconds past (and at boot if an hour was missed). A challenge week
# starts on Monday at 12 AM Pacific, a whole hour in any server time zone, so it is sent within the minute.
[Unit]
Description=Monkey SMP: weekly challenges clock, every hour

[Timer]
OnCalendar=*-*-* *:00:30
Persistent=true

[Install]
WantedBy=timers.target
