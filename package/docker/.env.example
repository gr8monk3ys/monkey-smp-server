# Settings for "docker compose up". Copy this file to .env in this folder, then edit it:
#     cp .env.example .env

# The server only starts once you agree to the Minecraft EULA: https://aka.ms/MinecraftEULA
# If you agree, change FALSE to TRUE.
EULA=FALSE

# Your Minecraft name. You become the server's admin on the first start. Empty = no admin.
OWNER=

# Server memory in GB, e.g. 6. Empty = picked from the memory Docker lets the server use.
# Leave at least 1-2 GB of the machine's memory for everything else.
MEMORY_GB=

# Ports on this machine that players connect to. The defaults suit almost everyone.
GAME_PORT=25565
VOICE_PORT=24454
MAP_PORT=8100

# Time zone for log and backup times, e.g. Europe/Berlin or America/New_York. Empty = UTC.
TZ=

# Run the server as this user and group id. Empty = the owner of the TheRealms-Server folder.
PUID=
PGID=
