# Generated by tools/firsts.py. Scores and storage are kept across restarts.
scoreboard objectives add firsts trigger
scoreboard objectives add rf dummy
scoreboard objectives add rf.diamond dummy
scoreboard objectives add rf.nether dummy
scoreboard objectives add rf.fortress dummy
scoreboard objectives add rf.bastion dummy
scoreboard objectives add rf.debris dummy
scoreboard objectives add rf.vault dummy
scoreboard objectives add rf.mace dummy
scoreboard objectives add rf.raid dummy
scoreboard objectives add rf.wither dummy
scoreboard objectives add rf.beacon dummy
scoreboard objectives add rf.end dummy
scoreboard objectives add rf.dragon dummy
scoreboard objectives add rf.elytra dummy
scoreboard objectives add rf.netherite dummy
scoreboard objectives add rf.boss dummy
# 0 for a first nobody holds yet (the advancements read it), without touching a claimed one.
scoreboard players add #diamond rf 0
scoreboard players add #nether rf 0
scoreboard players add #fortress rf 0
scoreboard players add #bastion rf 0
scoreboard players add #debris rf 0
scoreboard players add #vault rf 0
scoreboard players add #mace rf 0
scoreboard players add #raid rf 0
scoreboard players add #wither rf 0
scoreboard players add #beacon rf 0
scoreboard players add #end rf 0
scoreboard players add #dragon rf 0
scoreboard players add #elytra rf 0
scoreboard players add #netherite rf 0
scoreboard players add #boss rf 0
scoreboard players add #claimed rf 0
# A claim stored without its name by an older pack never set #unnamed: rename checks them all once.
scoreboard players set #unnamed rf 1
schedule function monkey:firsts/second 20t replace
