# Find a bastion: its line in /trigger firsts (one tellraw of the six runs).
execute unless score #bastion rf matches 1.. run return run tellraw @s [" ",{"text":"Find a bastion","color":"white","hover_event":{"action":"show_text","value":"Set foot in a bastion remnant."}},{"text":"  open","color":"gray"}]
execute store success score #named rf if data storage monkey:firsts held.bastion.name
execute if data storage monkey:firsts held.bastion{name:""} run scoreboard players set #named rf 0
execute store success score #dated rf if data storage monkey:firsts held.bastion.week
execute if data storage monkey:firsts held.bastion{week:-1} run scoreboard players set #dated rf 0
execute if score #named rf matches 1 if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Find a bastion","color":"green","hover_event":{"action":"show_text","value":"Set foot in a bastion remnant."}},{"text":"  ","color":"gray"},{"storage":"monkey:firsts","nbt":"held.bastion.name","color":"yellow"},{"text":"  week ","color":"dark_gray"},{"storage":"monkey:firsts","nbt":"held.bastion.week","color":"dark_gray"}]
