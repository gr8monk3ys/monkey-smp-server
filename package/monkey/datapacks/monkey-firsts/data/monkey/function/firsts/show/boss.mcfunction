# Slay a border boss: its line in /trigger firsts (one tellraw of the six runs).
execute unless score #season rw.day matches 2.. run return 0
execute unless score #boss rf matches 1.. run return run tellraw @s [" ",{"text":"Slay a border boss","color":"white","hover_event":{"action":"show_text","value":"Land the killing blow on the Edgewalker, the boss that rises on a border act (Season II on)."}},{"text":"  open","color":"gray"}]
execute store success score #named rf if data storage monkey:firsts held.boss.name
execute if data storage monkey:firsts held.boss{name:""} run scoreboard players set #named rf 0
execute store success score #dated rf if data storage monkey:firsts held.boss.week
execute if data storage monkey:firsts held.boss{week:-1} run scoreboard players set #dated rf 0
execute if score #named rf matches 1 if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Slay a border boss","color":"green","hover_event":{"action":"show_text","value":"Land the killing blow on the Edgewalker, the boss that rises on a border act (Season II on)."}},{"text":"  ","color":"gray"},{"storage":"monkey:firsts","nbt":"held.boss.name","color":"yellow"},{"text":"  week ","color":"dark_gray"},{"storage":"monkey:firsts","nbt":"held.boss.week","color":"dark_gray"}]
