# Find a Nether fortress: its line in /trigger firsts (one tellraw of the six runs).
execute unless score #fortress rf matches 1.. run return run tellraw @s [" ",{"text":"Find a Nether fortress","color":"white","hover_event":{"action":"show_text","value":"Set foot in a Nether fortress."}},{"text":"  open","color":"gray"}]
execute store success score #named rf if data storage monkey:firsts held.fortress.name
execute if data storage monkey:firsts held.fortress{name:""} run scoreboard players set #named rf 0
execute store success score #dated rf if data storage monkey:firsts held.fortress.week
execute if data storage monkey:firsts held.fortress{week:-1} run scoreboard players set #dated rf 0
execute if score #named rf matches 1 if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Find a Nether fortress","color":"green","hover_event":{"action":"show_text","value":"Set foot in a Nether fortress."}},{"text":"  ","color":"gray"},{"storage":"monkey:firsts","nbt":"held.fortress.name","color":"yellow"},{"text":"  week ","color":"dark_gray"},{"storage":"monkey:firsts","nbt":"held.fortress.week","color":"dark_gray"}]
