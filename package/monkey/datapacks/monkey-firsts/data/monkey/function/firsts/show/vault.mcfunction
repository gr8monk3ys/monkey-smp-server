# Open a trial vault: its line in /trigger firsts (one tellraw of the six runs).
execute unless score #vault rf matches 1.. run return run tellraw @s [" ",{"text":"Open a trial vault","color":"white","hover_event":{"action":"show_text","value":"Use a trial key (or an ominous one) on a vault in trial chambers."}},{"text":"  open","color":"gray"}]
execute store success score #named rf if data storage monkey:firsts held.vault.name
execute if data storage monkey:firsts held.vault{name:""} run scoreboard players set #named rf 0
execute store success score #dated rf if data storage monkey:firsts held.vault.week
execute if data storage monkey:firsts held.vault{week:-1} run scoreboard players set #dated rf 0
execute if score #named rf matches 1 if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Open a trial vault","color":"green","hover_event":{"action":"show_text","value":"Use a trial key (or an ominous one) on a vault in trial chambers."}},{"text":"  ","color":"gray"},{"storage":"monkey:firsts","nbt":"held.vault.name","color":"yellow"},{"text":"  week ","color":"dark_gray"},{"storage":"monkey:firsts","nbt":"held.vault.week","color":"dark_gray"}]
execute if score #named rf matches 1 run return run tellraw @s [" ",{"text":"Open a trial vault","color":"green","hover_event":{"action":"show_text","value":"Use a trial key (or an ominous one) on a vault in trial chambers."}},{"text":"  ","color":"gray"},{"storage":"monkey:firsts","nbt":"held.vault.name","color":"yellow"}]
execute if score #named rf matches 0 if entity @a[scores={rf.vault=1..}] if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Open a trial vault","color":"green","hover_event":{"action":"show_text","value":"Use a trial key (or an ominous one) on a vault in trial chambers."}},{"text":"  ","color":"gray"},{"selector":"@a[scores={rf.vault=1..}]","color":"yellow"},{"text":"  week ","color":"dark_gray"},{"storage":"monkey:firsts","nbt":"held.vault.week","color":"dark_gray"}]
execute if score #named rf matches 0 if entity @a[scores={rf.vault=1..}] run return run tellraw @s [" ",{"text":"Open a trial vault","color":"green","hover_event":{"action":"show_text","value":"Use a trial key (or an ominous one) on a vault in trial chambers."}},{"text":"  ","color":"gray"},{"selector":"@a[scores={rf.vault=1..}]","color":"yellow"}]
execute if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Open a trial vault","color":"green","hover_event":{"action":"show_text","value":"Use a trial key (or an ominous one) on a vault in trial chambers."}},{"text":"  ","color":"gray"},{"text":"a player now offline","color":"gray"},{"text":"  week ","color":"dark_gray"},{"storage":"monkey:firsts","nbt":"held.vault.week","color":"dark_gray"}]
