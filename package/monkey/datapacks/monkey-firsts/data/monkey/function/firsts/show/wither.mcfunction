# Defeat the Wither: its line in /trigger firsts (one tellraw of the six runs).
execute unless score #wither rf matches 1.. run return run tellraw @s [" ",{"text":"Defeat the Wither","color":"white","hover_event":{"action":"show_text","value":"Land the killing blow on a Wither."}},{"text":"  open","color":"gray"}]
execute store success score #named rf if data storage monkey:firsts held.wither.name
execute if data storage monkey:firsts held.wither{name:""} run scoreboard players set #named rf 0
execute store success score #dated rf if data storage monkey:firsts held.wither.week
execute if data storage monkey:firsts held.wither{week:-1} run scoreboard players set #dated rf 0
execute if score #named rf matches 1 if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Defeat the Wither","color":"green","hover_event":{"action":"show_text","value":"Land the killing blow on a Wither."}},{"text":"  ","color":"gray"},{"storage":"monkey:firsts","nbt":"held.wither.name","color":"yellow"},{"text":"  week ","color":"dark_gray"},{"storage":"monkey:firsts","nbt":"held.wither.week","color":"dark_gray"}]
execute if score #named rf matches 1 run return run tellraw @s [" ",{"text":"Defeat the Wither","color":"green","hover_event":{"action":"show_text","value":"Land the killing blow on a Wither."}},{"text":"  ","color":"gray"},{"storage":"monkey:firsts","nbt":"held.wither.name","color":"yellow"}]
execute if score #named rf matches 0 if entity @a[scores={rf.wither=1..}] if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Defeat the Wither","color":"green","hover_event":{"action":"show_text","value":"Land the killing blow on a Wither."}},{"text":"  ","color":"gray"},{"selector":"@a[scores={rf.wither=1..}]","color":"yellow"},{"text":"  week ","color":"dark_gray"},{"storage":"monkey:firsts","nbt":"held.wither.week","color":"dark_gray"}]
execute if score #named rf matches 0 if entity @a[scores={rf.wither=1..}] run return run tellraw @s [" ",{"text":"Defeat the Wither","color":"green","hover_event":{"action":"show_text","value":"Land the killing blow on a Wither."}},{"text":"  ","color":"gray"},{"selector":"@a[scores={rf.wither=1..}]","color":"yellow"}]
execute if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Defeat the Wither","color":"green","hover_event":{"action":"show_text","value":"Land the killing blow on a Wither."}},{"text":"  ","color":"gray"},{"text":"a player now offline","color":"gray"},{"text":"  week ","color":"dark_gray"},{"storage":"monkey:firsts","nbt":"held.wither.week","color":"dark_gray"}]
tellraw @s [" ",{"text":"Defeat the Wither","color":"green","hover_event":{"action":"show_text","value":"Land the killing blow on a Wither."}},{"text":"  ","color":"gray"},{"text":"a player now offline","color":"gray"}]
