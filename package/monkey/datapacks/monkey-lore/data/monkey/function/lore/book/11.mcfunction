give @s minecraft:written_book[minecraft:written_book_content={title:"Drawing In",author:"Mira Salt-Hand",pages:["Every circle closes. When Ruk's people had walked all the land he could give, he drew the rope back in, slowly, toward the tree where it began.","Not to punish them. To gather them: one last fight in a small circle, everyone close, then quiet. Then a new rope, tied somewhere new.","Finder, if you hold all eleven of my pages, you are a keeper of the knots now. Tie them well next time."]},minecraft:lore=[{text:"Page 11 of 11, the Knotkeeper's chronicle",color:"gray",italic:0b}]]
