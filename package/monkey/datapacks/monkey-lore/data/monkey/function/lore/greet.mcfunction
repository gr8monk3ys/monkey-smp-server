# As a player who hasn't heard this week's line from the Crier.
scoreboard players operation @s lr.seen = #told lr
execute if score #told lr matches 1 run tellraw @s ["",{"text":"[Town Crier] ","color":"yellow"},{"text":"Hear ye! A page of an old chronicle has turned up. It says the edge of our world is a rope, and that a monkey tied it. ","color":"white"},{"text":"Page 1, \"The Rope\", is hidden near spawn, where every road begins. ","color":"gray"},{"text":"/trigger lore","color":"aqua","click_event":{"action":"run_command","command":"/trigger lore"}}]
execute if score #told lr matches 2 run tellraw @s ["",{"text":"[Town Crier] ","color":"yellow"},{"text":"Hear ye! The border breaks on Saturday, and the chronicle says why. A second page is loose. ","color":"white"},{"text":"Page 2, \"The First Loosening\", is hidden near the world border, before it moves. ","color":"gray"},{"text":"/trigger lore","color":"aqua","click_event":{"action":"run_command","command":"/trigger lore"}}]
execute if score #told lr matches 3 run tellraw @s ["",{"text":"[Town Crier] ","color":"yellow"},{"text":"Hear ye! The End opens this week. The third page tells who set a dragon on its door, and why. ","color":"white"},{"text":"Page 3, \"The Far Gate\", is hidden near the way to the End. ","color":"gray"},{"text":"/trigger lore","color":"aqua","click_event":{"action":"run_command","command":"/trigger lore"}}]
execute if score #told lr matches 4 run tellraw @s ["",{"text":"[Town Crier] ","color":"yellow"},{"text":"Hear ye! Raid night again. The fourth page says raids are older than any of us. ","color":"white"},{"text":"Page 4, \"Cloth and Quarrels\", is hidden at one of the outposts. ","color":"gray"},{"text":"/trigger lore","color":"aqua","click_event":{"action":"run_command","command":"/trigger lore"}}]
execute if score #told lr matches 5 run tellraw @s ["",{"text":"[Town Crier] ","color":"yellow"},{"text":"Hear ye! The Netherite age begins. The fifth page says who buried the old metal, and why it waited. ","color":"white"},{"text":"Page 5, \"The Deep Metal\", is hidden in the Nether, near a portal. ","color":"gray"},{"text":"/trigger lore","color":"aqua","click_event":{"action":"run_command","command":"/trigger lore"}}]
execute if score #told lr matches 6 run tellraw @s ["",{"text":"[Town Crier] ","color":"yellow"},{"text":"Hear ye! Midwinter. The sixth page is about fires along the rope and very bad singing. ","color":"white"},{"text":"Page 6, \"The Long Night\", is hidden at spawn, under the Midwinter lights. ","color":"gray"},{"text":"/trigger lore","color":"aqua","click_event":{"action":"run_command","command":"/trigger lore"}}]
execute if score #told lr matches 7 run tellraw @s ["",{"text":"[Town Crier] ","color":"yellow"},{"text":"Hear ye! The border breaks again on Saturday. The seventh page warns there is not much rope left. ","color":"white"},{"text":"Page 7, \"The Second Loosening\", is hidden near the world border, before it moves again. ","color":"gray"},{"text":"/trigger lore","color":"aqua","click_event":{"action":"run_command","command":"/trigger lore"}}]
execute if score #told lr matches 8 run tellraw @s ["",{"text":"[Town Crier] ","color":"yellow"},{"text":"Hear ye! Build Battle week. The eighth page is about the one thing the Monkey King ever built. ","color":"white"},{"text":"Page 8, \"What He Built\", is hidden by the Build Battle plots. ","color":"gray"},{"text":"/trigger lore","color":"aqua","click_event":{"action":"run_command","command":"/trigger lore"}}]
execute if score #told lr matches 9 run tellraw @s ["",{"text":"[Town Crier] ","color":"yellow"},{"text":"Hear ye! Arena week. The ninth page tells of the day someone asked the Monkey King for his crown. ","color":"white"},{"text":"Page 9, \"The Borrowed Crown\", is hidden near the event arena. ","color":"gray"},{"text":"/trigger lore","color":"aqua","click_event":{"action":"run_command","command":"/trigger lore"}}]
execute if score #told lr matches 10 run tellraw @s ["",{"text":"[Town Crier] ","color":"yellow"},{"text":"Hear ye! The last raid. The tenth page answers the question everyone asks: did the Monkey King die? ","color":"white"},{"text":"Page 10, \"Where Ruk Went\", is hidden at one of the outposts. ","color":"gray"},{"text":"/trigger lore","color":"aqua","click_event":{"action":"run_command","command":"/trigger lore"}}]
execute if score #told lr matches 11 run tellraw @s ["",{"text":"[Town Crier] ","color":"yellow"},{"text":"Hear ye! The finale. The last page says why every circle closes, and what comes after. ","color":"white"},{"text":"Page 11, \"Drawing In\", is hidden at spawn, before the finale. ","color":"gray"},{"text":"/trigger lore","color":"aqua","click_event":{"action":"run_command","command":"/trigger lore"}}]
