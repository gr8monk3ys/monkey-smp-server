# Generated by tools/omens.py. Scores and storage are kept across restarts, and an omen that was on
# carries on where it was.
scoreboard objectives add om dummy
scoreboard objectives add om.pk playerKillCount
scoreboard objectives add om.deaths deathCount
scoreboard objectives add om.streak dummy
scoreboard objectives add om.blood dummy
scoreboard objectives add om.loot dummy
scoreboard objectives add om.hunt dummy
scoreboard players set #60 om 60
execute unless score #min om matches 1.. run scoreboard players set #min om 4
execute unless score #auto om matches 0.. run scoreboard players set #auto om 1
execute unless score #state om matches 0.. run scoreboard players set #state om 0
execute unless score #moon om matches 0.. run scoreboard players set #moon om 0
# The secret tools/omens.py plans the weeks with: drawn once, never shown, never changed.
execute unless score #key1 om matches 1.. store result score #key1 om run random value 1..1000000000
execute unless score #key2 om matches 1.. store result score #key2 om run random value 1..1000000000
schedule function monkey:omens/second 20t replace
