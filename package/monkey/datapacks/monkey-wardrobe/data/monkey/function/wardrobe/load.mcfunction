# Generated by tools/wardrobe.py. Scores are created once and kept across restarts.
scoreboard objectives add wardrobe trigger
scoreboard objectives add rw.play minecraft.custom:minecraft.play_time
scoreboard objectives add rw.hours dummy
scoreboard objectives add rw.days dummy
scoreboard objectives add rw.lastday dummy
scoreboard objectives add rw.months dummy
scoreboard objectives add rw.invites dummy
scoreboard objectives add rw.tier dummy
scoreboard objectives add rw.founder dummy
scoreboard objectives add rw.day dummy
scoreboard objectives add rw.const dummy
scoreboard objectives add rw.events dummy
scoreboard objectives add rw.playbase dummy
scoreboard objectives add rw.challenges dummy
scoreboard objectives add rw.launch dummy
scoreboard objectives add rw.launchtime dummy
scoreboard objectives add rw.quest dummy
scoreboard objectives add rw.hallowtide dummy
scoreboard objectives add rw.midwinter dummy
scoreboard objectives add rw.midsummer dummy
scoreboard objectives add rw.s2 dummy
scoreboard objectives add rw.champion dummy
scoreboard objectives add rw.months.seen dummy
scoreboard objectives add rw.events.seen dummy
scoreboard objectives add rw.hallowtide.seen dummy
scoreboard objectives add rw.midwinter.seen dummy
scoreboard objectives add rw.midsummer.seen dummy
scoreboard objectives add rw.challenges.seen dummy
scoreboard objectives add rw.launch.seen dummy
scoreboard objectives add rw.s2.seen dummy
scoreboard objectives add rw.champion.seen dummy
