# The wardrobe menu, this week's challenges and their skins: owned skins are green and clickable, locked ones say how to get them.
tellraw @s ["",{"text":"\nWeekly challenges","color":"gold","bold":true},{"text":"  new every Monday, 12 AM Pacific","color":"gray"}]
tellraw @s [{"text":"","color":"gray"},{"score":{"name":"@s","objective":"rw.challenges"},"color":"white"}," challenges done in all seasons"]
function monkey:challenges/lines
tellraw @s {"text":"Blades (hold the sword)","color":"gold"}
execute if score @s rw.founder matches 1.. run tellraw @s [" ",{"text":"[Founder's Edge]","color":"green","click_event":{"action":"run_command","command":"/trigger wardrobe set 107"},"hover_event":{"action":"show_text","value":"Put Founder's Edge on the sword in your hand"}},{"text":"  Played during the first season","color":"dark_gray"}]
execute unless score @s rw.founder matches 1.. run tellraw @s [" ",{"text":"Founder's Edge","color":"gray","hover_event":{"action":"show_text","value":"Locked: Played during the first season"}},{"text":"  Played during the first season","color":"dark_gray"}]
execute if score @s rw.challenges matches 3.. run tellraw @s [" ",{"text":"[Trailblazer]","color":"green","click_event":{"action":"run_command","command":"/trigger wardrobe set 117"},"hover_event":{"action":"show_text","value":"Put Trailblazer on the sword in your hand"}},{"text":"  3 weekly challenges","color":"dark_gray"}]
execute unless score @s rw.challenges matches 3.. run tellraw @s [" ",{"text":"Trailblazer","color":"gray","hover_event":{"action":"show_text","value":"Locked: 3 weekly challenges"}},{"text":"  3 weekly challenges","color":"dark_gray"}]
execute if score @s rw.challenges matches 18.. run tellraw @s [" ",{"text":"[Pinnacle]","color":"green","click_event":{"action":"run_command","command":"/trigger wardrobe set 118"},"hover_event":{"action":"show_text","value":"Put Pinnacle on the sword in your hand"}},{"text":"  18 weekly challenges","color":"dark_gray"}]
execute unless score @s rw.challenges matches 18.. run tellraw @s [" ",{"text":"Pinnacle","color":"gray","hover_event":{"action":"show_text","value":"Locked: 18 weekly challenges"}},{"text":"  18 weekly challenges","color":"dark_gray"}]
execute if score @s rw.s2 matches 1.. run tellraw @s [" ",{"text":"[Twinmoon]","color":"green","click_event":{"action":"run_command","command":"/trigger wardrobe set 119"},"hover_event":{"action":"show_text","value":"Put Twinmoon on the sword in your hand"}},{"text":"  Played during Season II","color":"dark_gray"}]
