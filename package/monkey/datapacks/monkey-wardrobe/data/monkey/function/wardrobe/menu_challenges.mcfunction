tellraw @s [" ",{"text":"[Earned in game]","color":"aqua","click_event":{"action":"run_command","command":"/trigger wardrobe set 1"}},"  ",{"text":"[Pass & supporter]","color":"aqua","click_event":{"action":"run_command","command":"/trigger wardrobe set 4"}}]
