tellraw @s {"text":"Helms (wear the helmet)","color":"gold"}
execute if score @s rw.challenges matches 9.. run tellraw @s [" ",{"text":"[Vanguard Helm]","color":"green","click_event":{"action":"run_command","command":"/trigger wardrobe set 207"},"hover_event":{"action":"show_text","value":"Put Vanguard Helm on the helmet you're wearing"}},{"text":"  9 weekly challenges","color":"dark_gray"}]
execute unless score @s rw.challenges matches 9.. run tellraw @s [" ",{"text":"Vanguard Helm","color":"gray","hover_event":{"action":"show_text","value":"Locked: 9 weekly challenges"}},{"text":"  9 weekly challenges","color":"dark_gray"}]
execute if score @s rw.launch matches 1.. run tellraw @s [" ",{"text":"[Founder's Circlet]","color":"green","click_event":{"action":"run_command","command":"/trigger wardrobe set 208"},"hover_event":{"action":"show_text","value":"Put Founder's Circlet on the helmet you're wearing"}},{"text":"  Played on Season I's launch weekend","color":"dark_gray"}]
execute unless score @s rw.launch matches 1.. run tellraw @s [" ",{"text":"Founder's Circlet","color":"gray","hover_event":{"action":"show_text","value":"Locked: Played on Season I's launch weekend"}},{"text":"  Played on Season I's launch weekend","color":"dark_gray"}]
execute if score @s rw.champion matches 1.. run tellraw @s [" ",{"text":"[Champion's Helm]","color":"green","click_event":{"action":"run_command","command":"/trigger wardrobe set 209"},"hover_event":{"action":"show_text","value":"Put Champion's Helm on the helmet you're wearing"}},{"text":"  The season champion's faction","color":"dark_gray"}]
