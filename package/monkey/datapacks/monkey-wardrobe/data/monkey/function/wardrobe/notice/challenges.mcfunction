# rw.challenges moved (the store, staff or an event set it): say which skins it just unlocked.
execute if score @s rw.challenges matches 3.. unless score @s rw.challenges.seen matches 3.. run tellraw @s [{"text":"Unlocked ","color":"gold"},{"text":"Trailblazer","color":"yellow"},{"text":" for 3 weekly challenges. ","color":"gold"},{"text":"[Open the wardrobe]","color":"aqua","underlined":true,"click_event":{"action":"run_command","command":"/trigger wardrobe set 5"}}]
execute if score @s rw.challenges matches 18.. unless score @s rw.challenges.seen matches 18.. run tellraw @s [{"text":"Unlocked ","color":"gold"},{"text":"Pinnacle","color":"yellow"},{"text":" for 18 weekly challenges. ","color":"gold"},{"text":"[Open the wardrobe]","color":"aqua","underlined":true,"click_event":{"action":"run_command","command":"/trigger wardrobe set 5"}}]
execute if score @s rw.challenges matches 9.. unless score @s rw.challenges.seen matches 9.. run tellraw @s [{"text":"Unlocked ","color":"gold"},{"text":"Vanguard Helm","color":"yellow"},{"text":" for 9 weekly challenges. ","color":"gold"},{"text":"[Open the wardrobe]","color":"aqua","underlined":true,"click_event":{"action":"run_command","command":"/trigger wardrobe set 5"}}]
scoreboard players operation @s rw.challenges.seen = @s rw.challenges
