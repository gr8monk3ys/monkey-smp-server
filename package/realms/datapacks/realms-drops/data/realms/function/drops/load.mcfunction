# Generated by tools/drops.py. Scores and storage are kept across restarts.
scoreboard objectives add dr dummy
scoreboard players set #60 dr 60
execute unless score #min dr matches 1.. run scoreboard players set #min dr 4
execute unless score #auto dr matches 0.. run scoreboard players set #auto dr 1
execute unless score #state dr matches 0.. run scoreboard players set #state dr 0
execute unless score #meteor dr matches 0.. run scoreboard players set #meteor dr 0
execute unless data storage realms:drops name run data modify storage realms:drops name set value {text:"Supply drop"}
schedule function realms:drops/second 20t replace
# Checking the ground when the server stopped: check again (a schedule may not outlast a restart).
execute if score #state dr matches 1 run schedule function realms:drops/check 20t replace
