# Light a beacon: its line in /trigger firsts (one tellraw of the six runs).
execute unless score #beacon rf matches 1.. run return run tellraw @s [" ",{"text":"Light a beacon","color":"white","hover_event":{"action":"show_text","value":"Build a beacon on a pyramid so it shines."}},{"text":"  open","color":"gray"}]
execute store success score #named rf if data storage realms:firsts held.beacon.name
execute if data storage realms:firsts held.beacon{name:""} run scoreboard players set #named rf 0
execute store success score #dated rf if data storage realms:firsts held.beacon.week
execute if data storage realms:firsts held.beacon{week:-1} run scoreboard players set #dated rf 0
execute if score #named rf matches 1 if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Light a beacon","color":"green","hover_event":{"action":"show_text","value":"Build a beacon on a pyramid so it shines."}},{"text":"  ","color":"gray"},{"storage":"realms:firsts","nbt":"held.beacon.name","color":"yellow"},{"text":"  week ","color":"dark_gray"},{"storage":"realms:firsts","nbt":"held.beacon.week","color":"dark_gray"}]
execute if score #named rf matches 1 run return run tellraw @s [" ",{"text":"Light a beacon","color":"green","hover_event":{"action":"show_text","value":"Build a beacon on a pyramid so it shines."}},{"text":"  ","color":"gray"},{"storage":"realms:firsts","nbt":"held.beacon.name","color":"yellow"}]
execute if score #named rf matches 0 if entity @a[scores={rf.beacon=1..}] if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Light a beacon","color":"green","hover_event":{"action":"show_text","value":"Build a beacon on a pyramid so it shines."}},{"text":"  ","color":"gray"},{"selector":"@a[scores={rf.beacon=1..}]","color":"yellow"},{"text":"  week ","color":"dark_gray"},{"storage":"realms:firsts","nbt":"held.beacon.week","color":"dark_gray"}]
execute if score #named rf matches 0 if entity @a[scores={rf.beacon=1..}] run return run tellraw @s [" ",{"text":"Light a beacon","color":"green","hover_event":{"action":"show_text","value":"Build a beacon on a pyramid so it shines."}},{"text":"  ","color":"gray"},{"selector":"@a[scores={rf.beacon=1..}]","color":"yellow"}]
execute if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Light a beacon","color":"green","hover_event":{"action":"show_text","value":"Build a beacon on a pyramid so it shines."}},{"text":"  ","color":"gray"},{"text":"a player now offline","color":"gray"},{"text":"  week ","color":"dark_gray"},{"storage":"realms:firsts","nbt":"held.beacon.week","color":"dark_gray"}]
tellraw @s [" ",{"text":"Light a beacon","color":"green","hover_event":{"action":"show_text","value":"Build a beacon on a pyramid so it shines."}},{"text":"  ","color":"gray"},{"text":"a player now offline","color":"gray"}]
