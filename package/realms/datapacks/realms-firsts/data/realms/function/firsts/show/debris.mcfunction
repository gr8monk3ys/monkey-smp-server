# Find ancient debris: its line in /trigger firsts (one tellraw of the six runs).
execute unless score #debris rf matches 1.. run return run tellraw @s [" ",{"text":"Find ancient debris","color":"white","hover_event":{"action":"show_text","value":"Hold a block of ancient debris."}},{"text":"  open","color":"gray"}]
execute store success score #named rf if data storage realms:firsts held.debris.name
execute if data storage realms:firsts held.debris{name:""} run scoreboard players set #named rf 0
