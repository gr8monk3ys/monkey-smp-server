# Slay the dragon: its line in /trigger firsts (one tellraw of the six runs).
execute unless score #dragon rf matches 1.. run return run tellraw @s [" ",{"text":"Slay the dragon","color":"white","hover_event":{"action":"show_text","value":"Land the killing blow on the Ender Dragon."}},{"text":"  open","color":"gray"}]
execute store success score #named rf if data storage realms:firsts held.dragon.name
execute if data storage realms:firsts held.dragon{name:""} run scoreboard players set #named rf 0
execute store success score #dated rf if data storage realms:firsts held.dragon.week
execute if data storage realms:firsts held.dragon{week:-1} run scoreboard players set #dated rf 0
execute if score #named rf matches 1 if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Slay the dragon","color":"green","hover_event":{"action":"show_text","value":"Land the killing blow on the Ender Dragon."}},{"text":"  ","color":"gray"},{"storage":"realms:firsts","nbt":"held.dragon.name","color":"yellow"},{"text":"  week ","color":"dark_gray"},{"storage":"realms:firsts","nbt":"held.dragon.week","color":"dark_gray"}]
execute if score #named rf matches 1 run return run tellraw @s [" ",{"text":"Slay the dragon","color":"green","hover_event":{"action":"show_text","value":"Land the killing blow on the Ender Dragon."}},{"text":"  ","color":"gray"},{"storage":"realms:firsts","nbt":"held.dragon.name","color":"yellow"}]
execute if score #named rf matches 0 if entity @a[scores={rf.dragon=1..}] if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Slay the dragon","color":"green","hover_event":{"action":"show_text","value":"Land the killing blow on the Ender Dragon."}},{"text":"  ","color":"gray"},{"selector":"@a[scores={rf.dragon=1..}]","color":"yellow"},{"text":"  week ","color":"dark_gray"},{"storage":"realms:firsts","nbt":"held.dragon.week","color":"dark_gray"}]
execute if score #named rf matches 0 if entity @a[scores={rf.dragon=1..}] run return run tellraw @s [" ",{"text":"Slay the dragon","color":"green","hover_event":{"action":"show_text","value":"Land the killing blow on the Ender Dragon."}},{"text":"  ","color":"gray"},{"selector":"@a[scores={rf.dragon=1..}]","color":"yellow"}]
execute if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Slay the dragon","color":"green","hover_event":{"action":"show_text","value":"Land the killing blow on the Ender Dragon."}},{"text":"  ","color":"gray"},{"text":"a player now offline","color":"gray"},{"text":"  week ","color":"dark_gray"},{"storage":"realms:firsts","nbt":"held.dragon.week","color":"dark_gray"}]
