# Find an elytra: its line in /trigger firsts (one tellraw of the six runs).
execute unless score #elytra rf matches 1.. run return run tellraw @s [" ",{"text":"Find an elytra","color":"white","hover_event":{"action":"show_text","value":"Hold an elytra, from an End ship."}},{"text":"  open","color":"gray"}]
execute store success score #named rf if data storage realms:firsts held.elytra.name
execute if data storage realms:firsts held.elytra{name:""} run scoreboard players set #named rf 0
execute store success score #dated rf if data storage realms:firsts held.elytra.week
execute if data storage realms:firsts held.elytra{week:-1} run scoreboard players set #dated rf 0
execute if score #named rf matches 1 if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Find an elytra","color":"green","hover_event":{"action":"show_text","value":"Hold an elytra, from an End ship."}},{"text":"  ","color":"gray"},{"storage":"realms:firsts","nbt":"held.elytra.name","color":"yellow"},{"text":"  week ","color":"dark_gray"},{"storage":"realms:firsts","nbt":"held.elytra.week","color":"dark_gray"}]
