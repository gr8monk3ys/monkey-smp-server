# Enter the End: its line in /trigger firsts (one tellraw of the six runs).
execute unless score #end rf matches 1.. run return run tellraw @s [" ",{"text":"Enter the End","color":"white","hover_event":{"action":"show_text","value":"Go through an End portal once the End opens (Dragon Night)."}},{"text":"  open","color":"gray"}]
execute store success score #named rf if data storage realms:firsts held.end.name
execute if data storage realms:firsts held.end{name:""} run scoreboard players set #named rf 0
execute store success score #dated rf if data storage realms:firsts held.end.week
execute if data storage realms:firsts held.end{week:-1} run scoreboard players set #dated rf 0
execute if score #named rf matches 1 if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Enter the End","color":"green","hover_event":{"action":"show_text","value":"Go through an End portal once the End opens (Dragon Night)."}},{"text":"  ","color":"gray"},{"storage":"realms:firsts","nbt":"held.end.name","color":"yellow"},{"text":"  week ","color":"dark_gray"},{"storage":"realms:firsts","nbt":"held.end.week","color":"dark_gray"}]
execute if score #named rf matches 1 run return run tellraw @s [" ",{"text":"Enter the End","color":"green","hover_event":{"action":"show_text","value":"Go through an End portal once the End opens (Dragon Night)."}},{"text":"  ","color":"gray"},{"storage":"realms:firsts","nbt":"held.end.name","color":"yellow"}]
execute if score #named rf matches 0 if entity @a[scores={rf.end=1..}] if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Enter the End","color":"green","hover_event":{"action":"show_text","value":"Go through an End portal once the End opens (Dragon Night)."}},{"text":"  ","color":"gray"},{"selector":"@a[scores={rf.end=1..}]","color":"yellow"},{"text":"  week ","color":"dark_gray"},{"storage":"realms:firsts","nbt":"held.end.week","color":"dark_gray"}]
execute if score #named rf matches 0 if entity @a[scores={rf.end=1..}] run return run tellraw @s [" ",{"text":"Enter the End","color":"green","hover_event":{"action":"show_text","value":"Go through an End portal once the End opens (Dragon Night)."}},{"text":"  ","color":"gray"},{"selector":"@a[scores={rf.end=1..}]","color":"yellow"}]
execute if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Enter the End","color":"green","hover_event":{"action":"show_text","value":"Go through an End portal once the End opens (Dragon Night)."}},{"text":"  ","color":"gray"},{"text":"a player now offline","color":"gray"},{"text":"  week ","color":"dark_gray"},{"storage":"realms:firsts","nbt":"held.end.week","color":"dark_gray"}]
