# Get a mace: its line in /trigger firsts (one tellraw of the six runs).
execute unless score #mace rf matches 1.. run return run tellraw @s [" ",{"text":"Get a mace","color":"white","hover_event":{"action":"show_text","value":"Hold a mace, from an ominous vault's heavy core. Enchanted maces stay banned (B2)."}},{"text":"  open","color":"gray"}]
execute store success score #named rf if data storage realms:firsts held.mace.name
execute if data storage realms:firsts held.mace{name:""} run scoreboard players set #named rf 0
execute store success score #dated rf if data storage realms:firsts held.mace.week
execute if data storage realms:firsts held.mace{week:-1} run scoreboard players set #dated rf 0
execute if score #named rf matches 1 if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Get a mace","color":"green","hover_event":{"action":"show_text","value":"Hold a mace, from an ominous vault's heavy core. Enchanted maces stay banned (B2)."}},{"text":"  ","color":"gray"},{"storage":"realms:firsts","nbt":"held.mace.name","color":"yellow"},{"text":"  week ","color":"dark_gray"},{"storage":"realms:firsts","nbt":"held.mace.week","color":"dark_gray"}]
execute if score #named rf matches 1 run return run tellraw @s [" ",{"text":"Get a mace","color":"green","hover_event":{"action":"show_text","value":"Hold a mace, from an ominous vault's heavy core. Enchanted maces stay banned (B2)."}},{"text":"  ","color":"gray"},{"storage":"realms:firsts","nbt":"held.mace.name","color":"yellow"}]
execute if score #named rf matches 0 if entity @a[scores={rf.mace=1..}] if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Get a mace","color":"green","hover_event":{"action":"show_text","value":"Hold a mace, from an ominous vault's heavy core. Enchanted maces stay banned (B2)."}},{"text":"  ","color":"gray"},{"selector":"@a[scores={rf.mace=1..}]","color":"yellow"},{"text":"  week ","color":"dark_gray"},{"storage":"realms:firsts","nbt":"held.mace.week","color":"dark_gray"}]
execute if score #named rf matches 0 if entity @a[scores={rf.mace=1..}] run return run tellraw @s [" ",{"text":"Get a mace","color":"green","hover_event":{"action":"show_text","value":"Hold a mace, from an ominous vault's heavy core. Enchanted maces stay banned (B2)."}},{"text":"  ","color":"gray"},{"selector":"@a[scores={rf.mace=1..}]","color":"yellow"}]
execute if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Get a mace","color":"green","hover_event":{"action":"show_text","value":"Hold a mace, from an ominous vault's heavy core. Enchanted maces stay banned (B2)."}},{"text":"  ","color":"gray"},{"text":"a player now offline","color":"gray"},{"text":"  week ","color":"dark_gray"},{"storage":"realms:firsts","nbt":"held.mace.week","color":"dark_gray"}]
