execute if score #named rf matches 0 if entity @a[scores={rf.nether=1..}] if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Enter the Nether","color":"green","hover_event":{"action":"show_text","value":"Go through a Nether portal (after the launch hour)."}},{"text":"  ","color":"gray"},{"selector":"@a[scores={rf.nether=1..}]","color":"yellow"},{"text":"  week ","color":"dark_gray"},{"storage":"realms:firsts","nbt":"held.nether.week","color":"dark_gray"}]
