# Enter the Nether: its line in /trigger firsts (one tellraw of the six runs).
execute unless score #nether rf matches 1.. run return run tellraw @s [" ",{"text":"Enter the Nether","color":"white","hover_event":{"action":"show_text","value":"Go through a Nether portal (after the launch hour)."}},{"text":"  open","color":"gray"}]
execute store success score #named rf if data storage realms:firsts held.nether.name
execute if data storage realms:firsts held.nether{name:""} run scoreboard players set #named rf 0
execute store success score #dated rf if data storage realms:firsts held.nether.week
execute if data storage realms:firsts held.nether{week:-1} run scoreboard players set #dated rf 0
execute if score #named rf matches 1 if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Enter the Nether","color":"green","hover_event":{"action":"show_text","value":"Go through a Nether portal (after the launch hour)."}},{"text":"  ","color":"gray"},{"storage":"realms:firsts","nbt":"held.nether.name","color":"yellow"},{"text":"  week ","color":"dark_gray"},{"storage":"realms:firsts","nbt":"held.nether.week","color":"dark_gray"}]
