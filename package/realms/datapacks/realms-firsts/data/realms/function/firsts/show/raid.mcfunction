# Win a raid: its line in /trigger firsts (one tellraw of the six runs).
execute unless score #raid rf matches 1.. run return run tellraw @s [" ",{"text":"Win a raid","color":"white","hover_event":{"action":"show_text","value":"Defend a village through a whole raid."}},{"text":"  open","color":"gray"}]
execute store success score #named rf if data storage realms:firsts held.raid.name
execute if data storage realms:firsts held.raid{name:""} run scoreboard players set #named rf 0
execute store success score #dated rf if data storage realms:firsts held.raid.week
execute if data storage realms:firsts held.raid{week:-1} run scoreboard players set #dated rf 0
execute if score #named rf matches 1 if score #dated rf matches 1 run return run tellraw @s [" ",{"text":"Win a raid","color":"green","hover_event":{"action":"show_text","value":"Defend a village through a whole raid."}},{"text":"  ","color":"gray"},{"storage":"realms:firsts","nbt":"held.raid.name","color":"yellow"},{"text":"  week ","color":"dark_gray"},{"storage":"realms:firsts","nbt":"held.raid.week","color":"dark_gray"}]
