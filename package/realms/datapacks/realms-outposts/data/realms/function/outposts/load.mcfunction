# Generated by tools/outposts.py. Scores and storage are kept across restarts.
scoreboard objectives add op dummy
scoreboard objectives add op.hold dummy
scoreboard objectives add op.by dummy
scoreboard objectives add op.prog dummy
scoreboard objectives add op.min dummy
scoreboard objectives add op.id dummy
scoreboard objectives add outposts trigger
execute unless score #auto op matches 0.. run scoreboard players set #auto op 1
execute unless score #busy op matches 0.. run scoreboard players set #busy op 0
execute unless data storage realms:outposts log run data modify storage realms:outposts log set value []
scoreboard players set #60 op 60
schedule function realms:outposts/second 20t replace
# Checking the ground when the server stopped: check again (a schedule may not outlast a restart).
execute if score #busy op matches 1 run schedule function realms:outposts/check 20t replace
