# The Realms: scan for enchanting blocks twice a second per player, not every tick. The 968 block checks
# below ran for every player on every tick, which was a quarter of the server's tick with 25 players online.
scoreboard objectives add Realms+Enchant_Check dummy
scoreboard players add @s Realms+Enchant_Check 1
execute unless score @s Realms+Enchant_Check matches 10.. run return run advancement revoke @s only strength_smp:technical/enchant/check
scoreboard players set @s Realms+Enchant_Check 0

# Check
execute positioned ~ ~5 ~ unless entity @e[type=minecraft:marker,tag=Strength_SMP+Enchanting_Block,distance=..1,sort=nearest,limit=1] if block ~ ~ ~ #strength_smp:enchanting_block align xyz positioned ~0.5 ~0.5 ~0.5 run summon minecraft:marker ~ ~ ~ {Tags:["Strength_SMP+Enchanting_Block"]}
